---
// The mark: the favicon's chevron "A", drawn in currentColor so it sits on
// any ground. `wordmark` adds the name beside it.
interface Props {
  size?: number;
  wordmark?: boolean;
  class?: string;
}
const { size = 28, wordmark = false, class: className = "" } = Astro.props;
---

<span class:list={["inline-flex items-center gap-2.5", className]}>
  <svg
    width={size}
    height={size}
    viewBox="0 0 64 64"
    aria-hidden="true"
    class="shrink-0"
  >
    <rect width="64" height="64" rx="12" fill="currentColor" />
    <path
      d="M18 44 L32 20 L46 44"
      fill="none"
      stroke="var(--bg)"
      stroke-width="6"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
  {wordmark && <span class="font-medium tracking-[-0.01em]"><slot>made by Anirudha</slot></span>}
</span>
