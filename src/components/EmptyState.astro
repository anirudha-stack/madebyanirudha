---
// Shown where a section exists but nothing has been published in it yet.
import BrokenGear from "./BrokenGear.astro";
import Icon from "./Icon.astro";

interface Props {
  title: string;
  body: string;
}
const { title, body } = Astro.props;
const elsewhere = [
  { label: "Projects", href: "/projects" },
  { label: "Instagram", href: "https://www.instagram.com/madebyanirudha/" },
  { label: "YouTube", href: "https://www.youtube.com/@madebyanirudha" },
];
---

<div class="grid items-center gap-10 border-t border-rule pt-10 sm:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] sm:gap-16">
  <div>
    <h2 class="text-[1.5rem] leading-[1.15] tracking-[-0.02em] sm:text-[1.75rem]">{title}</h2>
    <p class="mt-3 max-w-[46ch] text-[1.0625rem] leading-[1.55] text-muted">{body}</p>
    <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-[0.9375rem]">
      {elsewhere.map((l) => (
        <li>
          <a href={l.href} rel={l.href.startsWith("http") ? "me noopener" : undefined} class="inline-flex items-center gap-1.5">
            <span class="link">{l.label}</span>
            {l.href.startsWith("http") && <Icon name="arrow-up-right" size={14} class="text-accent" />}
          </a>
        </li>
      ))}
    </ul>
  </div>
  <BrokenGear class="w-full max-w-[20rem] justify-self-center sm:justify-self-end" />
</div>
