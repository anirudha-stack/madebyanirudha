---
import { site } from "../site";

const year = new Date().getFullYear();
const links = [{ label: site.email, href: `mailto:${site.email}` }, ...site.links];
---

<footer class="mx-auto mt-24 w-full max-w-measure px-5 pb-10 sm:px-8">
  <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-3 border-t border-rule pt-6 text-[0.9375rem]">
    <ul class="flex flex-wrap gap-x-6 gap-y-2">
      {links.map((l) => (
        <li><a class="link" href={l.href} rel={l.href.startsWith("http") ? "me noopener" : undefined}>{l.label}</a></li>
      ))}
    </ul>
    <p class="flex flex-wrap gap-x-5 gap-y-2 text-muted">
      <a class="link" href="/privacy">Privacy</a>
      <a class="link" href="/rss.xml">RSS</a>
      {/* Usage instrumentation. Hidden until the real count loads client-side,
          so a static build never ships a stale or placeholder figure and a
          no-JS visit simply shows nothing. */}
      <span data-views hidden><span class="num" data-views-count></span> visitors</span>
      <span><span class="num">{year}</span> · {site.wordmark}</span>
    </p>
  </div>
</footer>

<script>
  // First-party visitor counter. Reads the running total from /api/views and
  // reveals the footer slot; the first time a given browser visits, it also
  // records the visit. Progressive enhancement only — any failure (no JS,
  // offline, blocked storage) simply leaves the slot hidden.
  (async () => {
    const STORAGE_KEY = "mba:counted";

    // A browser we have never counted contributes one visit; every later visit
    // is read-only. localStorage may throw (private mode, blocked storage), in
    // which case we fall back to a read so we never inflate the total.
    let firstVisit = false;
    try {
      firstVisit = !localStorage.getItem(STORAGE_KEY);
    } catch {
      firstVisit = false;
    }

    try {
      const res = await fetch("/api/views", { method: firstVisit ? "POST" : "GET" });
      if (!res.ok) return;
      const { total } = (await res.json()) as { total?: number };
      if (typeof total !== "number") return;

      const slot = document.querySelector<HTMLElement>("[data-views]");
      const out = document.querySelector<HTMLElement>("[data-views-count]");
      if (!slot || !out) return;

      out.textContent = new Intl.NumberFormat("en-GB").format(total);
      slot.hidden = false;

      if (firstVisit) {
        try {
          localStorage.setItem(STORAGE_KEY, "1");
        } catch {
          // Nothing to do: worst case this browser is counted again next visit.
        }
      }
    } catch {
      // Network or parse failure: leave the count hidden rather than guess.
    }
  })();
</script>
