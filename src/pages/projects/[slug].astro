---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import Ledger from "../../components/Ledger.astro";
import Base from "../../layouts/Base.astro";
import { site } from "../../site";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const fmt = new Intl.DateTimeFormat("en-GB", { month: "long", year: "numeric" });
---

<Base title={project.data.title} description={project.data.summary} image={new URL(project.data.cover.src, site.domain).href}>
  <article class="pt-10 sm:pt-16">
    <header class="max-w-[60ch]">
      <h1 class="text-[2rem] leading-[1.08] tracking-[-0.03em] sm:text-[2.75rem]">{project.data.title}</h1>
      <p class="mt-4 text-[1.125rem] text-muted">{project.data.summary}</p>
      <p class="mt-3 text-[0.875rem] text-muted">
        <time datetime={project.data.date.toISOString()}>{fmt.format(project.data.date)}</time>
        {project.data.synthetic && <> · <span class="font-[500] text-fg">Stand-in</span> content</>}
      </p>
    </header>

    <div class="-mx-5 mt-10 sm:mx-0">
      <Image
        src={project.data.cover}
        alt={project.data.coverAlt}
        widths={[640, 960, 1280, 1600, 2240]}
        sizes="(min-width: 1184px) 1120px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="aspect-[16/10] w-full object-cover"
        style="view-transition-name: flagship-cover"
      />
    </div>

    <Ledger layers={project.data.layers} class="mt-6" />

    {(project.data.links.repo || project.data.links.files) && (
      <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-[0.9375rem]">
        {project.data.links.repo && <li><a class="link" href={project.data.links.repo} rel="noopener">Source</a></li>}
        {project.data.links.files && <li><a class="link" href={project.data.links.files} rel="noopener">Design files</a></li>}
      </ul>
    )}

    <div class="prose mt-14">
      <Content />
    </div>

    {project.data.gallery.length > 0 && (
      <section class="mt-16" aria-label="Photographs">
        <ul class="grid gap-6 sm:grid-cols-2">
          {project.data.gallery.map((g) => (
            <li>
              <Image src={g.src} alt={g.alt} widths={[640, 960, 1280]} sizes="(min-width: 640px) 560px, 100vw" class="w-full" />
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</Base>
