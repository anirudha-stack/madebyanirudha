---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Ledger from "../components/Ledger.astro";
import Base from "../layouts/Base.astro";
import { site } from "../site";

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const flagship = projects.find((p) => p.data.flagship) ?? projects[0];
const supporting = projects.filter((p) => p !== flagship).slice(0, 2);

const byDate = <T extends { data: { date: Date; draft: boolean } }>(entries: T[]) =>
  entries.filter((e) => !e.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const logs = byDate(await getCollection("logs")).slice(0, 5);
const guides = byDate(await getCollection("guides")).slice(0, 5);

const fmt = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", year: "numeric" });
---

<Base image={flagship ? new URL(flagship.data.cover.src, site.domain).href : undefined}>
  <section class="pt-12 sm:pt-16">
    <h1 class="text-[1.5rem] font-[500] leading-[1.2] tracking-[-0.02em] sm:text-[2rem]">{site.identity}</h1>
    <p class="mt-4 max-w-[58ch] text-[1.0625rem] leading-[1.55] text-muted sm:mt-5 sm:text-[1.125rem]">
      I'm Anirudha, a senior applied AI engineer by profession. At home I build hardware:
      the circuit board, the enclosure, the firmware and the software, the whole device.
      This is where the builds live: what I made, how it went, and what broke along the way.
    </p>
  </section>

  {flagship && (
    <section class="mt-10 sm:mt-12" aria-labelledby="flagship-title">
      <a href={`/projects/${flagship.id}`} class="-mx-5 block sm:mx-0" aria-label={`${flagship.data.title}: see the build`}>
        <Image
          src={flagship.data.cover}
          alt={flagship.data.coverAlt}
          widths={[640, 960, 1280, 1600, 2240]}
          sizes="(min-width: 1184px) 1120px, 100vw"
          loading="eager"
          fetchpriority="high"
          class="aspect-[16/10] w-full object-cover"
          style="view-transition-name: flagship-cover"
        />
      </a>
      <div class="mt-5 flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2">
        <h2 id="flagship-title" class="text-[1.5rem] tracking-[-0.02em] sm:text-[1.75rem]">
          <a href={`/projects/${flagship.id}`}>{flagship.data.title}</a>
        </h2>
        <a href={`/projects/${flagship.id}`} class="text-[0.9375rem]">
          <span class="link">See the build</span> <span aria-hidden="true" class="text-accent">→</span>
        </a>
      </div>
      <p class="mt-2 max-w-[60ch] text-muted">{flagship.data.summary}</p>
      {flagship.data.synthetic && (
        <p class="mt-3 text-[0.8125rem] text-muted">
          <span class="font-[500] text-fg">Stand-in</span> — layer facts and photograph are placeholders until the build is documented.
        </p>
      )}
      <Ledger layers={flagship.data.layers} class="mt-6" />
    </section>
  )}

  {supporting.length > 0 && (
    <section class="mt-20" aria-labelledby="more-title">
      <h2 id="more-title" class="text-[0.9375rem] font-normal text-muted">Also built</h2>
      <ul class="mt-4 grid gap-10 border-t border-rule pt-8 sm:grid-cols-2">
        {supporting.map((p) => (
          <li>
            <a href={`/projects/${p.id}`} class="block">
              <Image src={p.data.cover} alt={p.data.coverAlt} widths={[480, 720, 1080]} sizes="(min-width: 640px) 540px, 100vw" class="aspect-[16/10] w-full object-cover" />
              <h3 class="mt-4 text-[1.125rem]"><span class="link">{p.data.title}</span></h3>
              <p class="mt-1 text-[0.9375rem] text-muted">{p.data.summary}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {(logs.length > 0 || guides.length > 0) && (
    <div class="mt-20 grid gap-16 sm:grid-cols-2 sm:gap-12">
      {logs.length > 0 && (
        <section aria-labelledby="logs-title">
          <div class="flex items-baseline justify-between">
            <h2 id="logs-title" class="text-[0.9375rem] font-normal text-muted">Build logs</h2>
            <a href="/logs" class="link text-[0.875rem]">All logs</a>
          </div>
          <ul class="mt-4 border-t border-rule">
            {logs.map((e) => (
              <li class="border-b border-rule py-4">
                <a href={`/logs/${e.id}`} class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                  <span class="link">{e.data.title}</span>
                  <time datetime={e.data.date.toISOString()} class="shrink-0 text-muted">{fmt.format(e.data.date)}</time>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
      {guides.length > 0 && (
        <section aria-labelledby="guides-title">
          <div class="flex items-baseline justify-between">
            <h2 id="guides-title" class="text-[0.9375rem] font-normal text-muted">How-to guides</h2>
            <a href="/guides" class="link text-[0.875rem]">All guides</a>
          </div>
          <ul class="mt-4 border-t border-rule">
            {guides.map((e) => (
              <li class="border-b border-rule py-4">
                <a href={`/guides/${e.id}`} class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                  <span class="link">{e.data.title}</span>
                  <time datetime={e.data.date.toISOString()} class="shrink-0 text-muted">{fmt.format(e.data.date)}</time>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  )}
</Base>
