---
import { getCollection } from "astro:content";
import EmptyState from "../../components/EmptyState.astro";
import PostList from "../../components/PostList.astro";
import Base from "../../layouts/Base.astro";

const entries = (await getCollection("guides", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="How-to guides" description="Step-by-step builds you can reproduce, with parts and files.">
  <section class="pt-10 sm:pt-16">
    <h1 class="text-[2rem] leading-[1.08] tracking-[-0.03em] sm:text-[2.75rem]">How-to guides</h1>
    <p class="mt-4 max-w-[60ch] text-[1.125rem] text-muted">Step-by-step builds you can reproduce, with parts and files.</p>
    <div class="mt-10">
      {entries.length === 0 && (
        <EmptyState title="Still on the bench." body="The first guide is being written and tested. A guide only ships once somebody else can follow it, which is the slow part." />
      )}
      {entries.length > 0 && <PostList entries={entries} base="/guides" />}
    </div>
  </section>
</Base>
