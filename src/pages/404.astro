---
import Icon from "../components/Icon.astro";
import Base from "../layouts/Base.astro";
---

<Base title="Not found" description="That page does not exist.">
  <section class="flex min-h-[60svh] flex-col justify-center py-16">
    <p class="text-[0.9375rem] text-muted"><span class="num text-accent">404</span></p>
    <h1 class="mt-3 text-[2rem] leading-[1.08] tracking-[-0.03em] sm:text-[2.75rem]">Nothing at this address.</h1>
    <p class="mt-4 max-w-[52ch] text-[1.125rem] text-muted">
      Either the link is old or I moved the thing. Everything that exists is reachable from the home page.
    </p>
    <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-[0.9375rem]">
      <li><a href="/" class="inline-flex items-center gap-2"><span class="link">Home</span> <Icon name="arrow-right" size={16} class="text-accent" /></a></li>
      <li><a href="/projects" class="link">Projects</a></li>
      <li><a href="/logs" class="link">Build logs</a></li>
      <li><a href="/guides" class="link">Guides</a></li>
    </ul>
  </section>
</Base>
