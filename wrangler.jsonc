{
  // Cloudflare Worker — madebyanirudha.in
  // Account: madebyanirudha@gmail.com (must match the account holding the zone).
  //
  // The site is a prerendered Astro bundle: `npm run build` writes ./dist
  // (pages plus everything in ./public, e.g. _headers). A small Worker sits in
  // front of it for exactly one dynamic route, /api/views (the visitor
  // counter). Every other request is handed straight to the static assets via
  // the ASSETS binding, so the pages still serve off the edge with no per-page
  // Worker cost.
  //
  // If a heavier server route is ever needed (store checkout), reach for
  // @astrojs/cloudflare for that route; this hand-written Worker stays as the
  // front door.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "madebyanirudha",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-24",
  // The site is only ever served on the custom domains below, never on a
  // *.workers.dev URL. Disabling that route keeps the canonical domain the one
  // way in, and — because the account has no workers.dev subdomain — is also
  // what lets `wrangler deploy` publish a Worker at all (otherwise it fails
  // with "You need a workers.dev subdomain", API error 10063).
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // The visitor total lives in one Durable Object (SQLite-backed, free tier).
  // Serialised access makes the increment atomic, so counts never race.
  "durable_objects": {
    "bindings": [{ "name": "COUNTER", "class_name": "Counter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Counter"] }],
  // Custom domains. Cloudflare creates and manages the proxied DNS records for
  // these, which is also what evicts the GoDaddy parking records.
  // TODO: once a Worker script exists, 301 www -> apex for canonicalisation.
  "routes": [
    { "pattern": "madebyanirudha.in", "custom_domain": true },
    { "pattern": "www.madebyanirudha.in", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
